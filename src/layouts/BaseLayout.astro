---
import "@fontsource-variable/instrument-sans/wght.css";
import "../styles/global.css";

type PageType = "profile" | "website" | "article";

interface Props {
  title: string;
  description: string;
  type?: PageType;
  publishedAt?: Date;
  updatedAt?: Date;
}

const { title, description, type = "profile", publishedAt, updatedAt } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Omer Cohen",
  url: "https://omer.cohen.io",
  jobTitle: "Chief Security Officer",
  worksFor: {
    "@type": "Organization",
    name: "Descope",
    url: "https://www.descope.com",
  },
  sameAs: [
    "https://github.com/omercnet",
    "https://github.com/tektum",
    "https://www.linkedin.com/in/omercohen",
  ],
};
const schema =
  type === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title.replace(" — Omer Cohen", ""),
        description,
        url: canonicalURL.toString(),
        datePublished: publishedAt?.toISOString(),
        dateModified: (updatedAt ?? publishedAt)?.toISOString(),
        author: personSchema,
      }
    : type === "profile"
      ? personSchema
      : {
          "@context": "https://schema.org",
          "@type": "WebSite",
          name: "Omer Cohen",
          url: "https://omer.cohen.io",
        };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content={description}>
    <meta name="theme-color" content="#101b17">
    <meta name="color-scheme" content="dark">
    <link rel="canonical" href={canonicalURL}>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="alternate" type="application/rss+xml" title="Omer Cohen — Writing" href="/rss.xml">

    <meta property="og:type" content={type}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonicalURL}>
    <meta property="og:site_name" content="Omer Cohen">
    <meta name="twitter:card" content="summary">
    {type === "profile" && (
        <>
          <meta property="profile:first_name" content="Omer" />
          <meta property="profile:last_name" content="Cohen" />
        </>
      )}
    {type === "article" && publishedAt && (
        <>
          <meta property="article:published_time" content={publishedAt.toISOString()} />
          {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
        </>
      )}

    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <main id="content" class="wrap">
      <slot />
    </main>
  </body>
</html>
